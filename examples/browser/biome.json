{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"**",
			"!dist",
			"!node_modules",
			"!test-results",
			"!playwright-report"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": { "enabled": true },
	"formatter": { "indentStyle": "tab", "lineWidth": 80 }
}
